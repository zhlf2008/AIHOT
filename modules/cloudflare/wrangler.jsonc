{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "knit-fashion-hot",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-16",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*", "/feed.xml", "/robots.txt", "/llms.txt"] },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "knithot-db",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "d1-migrations"
  }],
  "triggers": { "crons": ["17 */2 * * *"] },
  "vars": { "COLLECT_ENABLED": "false" },
  "observability": { "enabled": true }
}
