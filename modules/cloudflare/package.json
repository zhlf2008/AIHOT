{
  "name": "@knithot/cloudflare",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled --port 8787",
    "check": "tsc -p tsconfig.json",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy --var COLLECT_ENABLED:true",
    "test": "node --test tests/*.test.ts",
    "db:local": "wrangler d1 migrations apply knithot-db --local",
    "db:remote": "wrangler d1 migrations apply knithot-db --remote",
    "bootstrap": "node scripts/bootstrap.ts"
  },
  "dependencies": {
    "cheerio": "1.2.0",
    "fast-xml-parser": "5.11.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261016.1",
    "miniflare": "5.20261012.0-beta",
    "undici": "8.11.2",
    "wrangler": "4.151.0"
  }
}
