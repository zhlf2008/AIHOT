{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "knit-hot-media",
  "account_id": "6e4e1f26f98366c93187ba53f375f46b",
  "main": "worker.ts",
  "compatibility_date": "2026-10-16",
  "compatibility_flags": ["nodejs_compat"],
  "limits": { "cpu_ms": 30000 },
  "alias": { "@cf-wasm/photon": "@cf-wasm/photon/workerd", "@cf-wasm/resvg/legacy": "@cf-wasm/resvg/legacy/workerd" },
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": "../../../assets/og-fonts", "binding": "ASSETS", "run_worker_first": true },
  "kv_namespaces": [{ "binding": "MEDIA_CACHE", "id": "4653ae3f26024c9296765d7d1eff6da4" }],
  "workflows": [{ "binding": "RENDER", "name": "knithot-media-render", "class_name": "MediaWorkflow", "concurrency": { "limit": 2 } }],
  "observability": { "enabled": true }
}
