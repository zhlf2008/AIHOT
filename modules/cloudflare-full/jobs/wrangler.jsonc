{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "knit-hot-jobs",
  "account_id": "6e4e1f26f98366c93187ba53f375f46b",
  "main": ".build/worker.js",
  "no_bundle": true,
  "build": { "command": "node modules/cloudflare-full/jobs/build.mjs" },
  "compatibility_date": "2026-10-16",
  "compatibility_flags": ["nodejs_compat"],
  "limits": { "cpu_ms": 30000 },
  "workers_dev": true,
  "vars": {
    "SITE_URL": "https://knit-fashion-hot.534569779.workers.dev",
    "AIHOT_DATA_DIR": "/tmp/knithot/data",
    "COLLECT_ENABLED": "false",
    "MODEL_CALLS_ENABLED": "false",
    "LLM_BASE_URL": "https://api.minimax.cn/v1",
    "LLM_MODEL": "MiniMax-M3",
    "LLM_EXTRA_JSON": "{\"thinking\":{\"type\":\"disabled\"},\"reasoning_split\":true}",
    "LLM_JSON_MODE": "false",
    "LLM_REASONING_TOKENS": "0"
  },
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "a990bacb3c274caf94b482c6a6a800d0" }],
  "services": [{ "binding": "MEDIA", "service": "knit-hot-media" }],
  "workflows": [{ "binding": "EDITORIAL", "name": "knithot-editorial", "class_name": "EditorialWorkflow", "concurrency": { "limit": 1 } }],
  "triggers": { "crons": ["*/10 * * * *"] },
  "observability": { "enabled": true }
}
