{
  "name": "aihot",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "industry",
    "site",
    "modules/*"
  ],
  "engines": {
    "node": ">=24.11"
  },
  "overrides": {
    "fflate": "0.7.5"
  },
  "scripts": {
    "cf:dev": "npm run db:local -w @knithot/cloudflare && npm run dev -w @knithot/cloudflare",
    "cf:check": "npm run check -w @knithot/cloudflare && npm run test -w @knithot/cloudflare && npm run build -w @knithot/cloudflare",
    "cf:deploy": "npm run deploy -w @knithot/cloudflare",
    "cf:full:build": "node modules/cloudflare-full/api/build.mjs && node modules/cloudflare-full/web/build.mjs && node modules/cloudflare-full/jobs/build.mjs",
    "cf:full:deploy:api": "wrangler deploy --config modules/cloudflare-full/api/wrangler.jsonc",
    "cf:full:deploy:web": "node modules/cloudflare-full/web/build.mjs && wrangler deploy --config modules/cloudflare-full/web/wrangler.jsonc",
    "cf:full:deploy:jobs": "wrangler deploy --config modules/cloudflare-full/jobs/wrangler.jsonc",
    "cf:full:deploy:media": "wrangler deploy --config modules/cloudflare-full/media/wrangler.jsonc",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "dev:api": "npm run dev -w @aihot/api",
    "dev:worker": "npm run dev -w @aihot/worker",
    "dev:web": "npm run dev -w @aihot/web",
    "typecheck": "tsc -p packages/contracts && tsc -p packages/backend && tsc -p apps/api && tsc -p apps/worker && tsc -p tests && tsc -p modules && npm run typecheck -w @aihot/web",
    "test": "node --test-global-setup=tests/databases.ts --import ./tests/databases.ts --test --test-concurrency=6 --test-timeout=120000 \"tests/*.test.ts\" \"modules/*/tests/*.test.ts\"",
    "test:standalone": "node --import ./tests/standalone.ts --test --test-concurrency=6 --test-timeout=120000 \"tests/*.standalone.test.ts\" \"modules/*/tests/*.standalone.test.ts\""
  },
  "devDependencies": {
    "@cf-wasm/og": "0.5.0",
    "@cf-wasm/photon": "0.4.0",
    "@modelcontextprotocol/client": "2.2.0",
    "@playwright/test": "1.61.1",
    "@types/node": "26.6.3",
    "@types/sanitize-html": "2.16.1",
    "@types/turndown": "5.0.6",
    "esbuild": "0.28.2",
    "image-size": "2.0.2",
    "opentype.js": "1.3.4",
    "typescript": "7.0.2"
  }
}
